{
  "manifest_version": 3,
  "name": "Local Chrome Control",
  "description": "A local, user-controlled execution runtime for AI clients.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Local Chrome Control",
    "default_popup": "popup.html"
  },
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "debugger",
    "downloads",
    "history",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "tabGroups",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
